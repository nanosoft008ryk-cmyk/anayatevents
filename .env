# Production domain — drives every canonical, og:url, JSON-LD @id and sitemap.
# (Also set this in the Vercel project environment.)
VITE_SITE_URL=https://www.anayatevent.com

# Serve all 229 photographs from this site's own origin instead of the Lovable
# CDN. `npm run prebuild` mirrors them into public/__l5e at build time.
# Removes a third-party origin from the critical path — better LCP, and an
# image sitemap that declares URLs on the domain we actually control.
# To revert: set both to 0.
SELF_HOST_MEDIA=1
VITE_SELF_HOST_MEDIA=1
