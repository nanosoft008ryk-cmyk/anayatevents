# The one value that controls every absolute URL on the site:
# canonicals, og:url, Twitter metadata, JSON-LD, sitemaps, robots.txt, llms.txt.
#
# Set this to your production domain on the host you deploy to.
# Leave it unset in local development — the app then falls back to the
# origin it is served from for generated files, and to the development
# domain for canonicals.
VITE_SITE_URL=https://your-domain.com
