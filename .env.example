# The one value that controls every absolute URL on the site:
# canonicals, og:url, Twitter metadata, JSON-LD, sitemaps, robots.txt, llms.txt.
#
# Set this to your production domain on the host you deploy to.
# Leave it unset in local development — the app then falls back to the
# origin it is served from for generated files, and to the development
# domain for canonicals.
VITE_SITE_URL=https://your-domain.com

# Origin serving the CDN media (/__l5e/assets-v1/...). Optional — only set
# this if the photographs are moved to a different CDN.
VITE_ASSET_ORIGIN=https://anayatevents.lovable.app

# Fully self-hosted media: set to 1 to copy every photograph into the build
# (public/__l5e/...) at build time so images load from your own domain with
# no external CDN dependency at all.
SELF_HOST_MEDIA=1
VITE_SELF_HOST_MEDIA=1
